{
  "name": "dsh-opencodex-usage",
  "version": "0.1.0",
  "description": "Draggable OpenCodex quota & rate-limit floating monitor plugin for DeepSeek Harness (DSH) Web GUI",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/smoke.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Walvez/dsh-opencodex-usage.git"
  },
  "bugs": {
    "url": "https://github.com/Walvez/dsh-opencodex-usage/issues"
  },
  "homepage": "https://github.com/Walvez/dsh-opencodex-usage#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencodex",
    "codex",
    "quota",
    "rate-limit",
    "usage",
    "monitor",
    "cordis",
    "plugin"
  ],
  "author": "Walvez",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
